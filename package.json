{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "typecheck": "vue-tsc --noEmit",
        "format": "prettier --write resources/ tests/e2e/ *.ts *.json",
        "format:check": "prettier --check resources/ tests/e2e/ *.ts *.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^24.19.2",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/test-utils": "~2.4.6",
        "concurrently": "^10.0.3",
        "happy-dom": "^21.0.4",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.0.0",
        "typescript": "~5.9.3",
        "vite": "^8.0.0",
        "vitest": "^5.0.5",
        "vue-tsc": "^3.3.13"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.9.1",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.0",
        "reka-ui": "^2.11.0",
        "tw-animate-css": "^1.4.0",
        "vue": "^3.5.44"
    }
}
